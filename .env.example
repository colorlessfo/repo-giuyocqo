# Public HTTPS origin, without a trailing slash. Never put database credentials in frontend variables.
PUBLIC_URL=https://your-domain.example
# A reverse proxy on the same server terminates HTTPS; this is not a local development setting.
TRUST_PROXY=1
# Node.js runtime database location; the directory must be retained across deployments.
DATA_DIR=./data
PORT=3000

# Optional external PostgreSQL. Set securely in the hosting platform; never share it in chat.
# If omitted, local development continues to use the SQLite directory above.
# DATABASE_URL=
# Render free deployments require it and must also set REQUIRE_DATABASE_URL=true.
# DATABASE_SSL_CA= optional PEM supplied by the database provider if its CA is not publicly trusted.
